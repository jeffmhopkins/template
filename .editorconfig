# Editor defaults for every file. Editing this file is a governance change.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.md]
# A trailing double space is a Markdown line break.
trim_trailing_whitespace = false
indent_size = 2

[*.rs]
indent_size = 4

[*.py]
indent_size = 4

[*.{yml,yaml,toml,json,sh,mjs,js}]
indent_size = 2
