{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/repo *)",
      "Bash(scripts/bootstrap.sh --check)",
      "Bash(scripts/bootstrap.sh --check *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo deny check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git range-diff *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git fetch *)",
      "Bash(scripts/bootstrap.sh)",
      "Bash(scripts/bootstrap.sh --repo *)",
      "Bash(scripts/bootstrap.sh --also-require *)",
      "Bash(cargo run --manifest-path tools/repo/Cargo.toml *)",
      "Bash(node --test *)",
      "Bash(python3 --version)",
      "Bash(git --version)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree list *)",
      "Bash(git ls-remote *)",
      "Bash(git ls-tree *)",
      "Bash(git rev-list *)",
      "Bash(git cat-file *)",
      "Bash(git apply *)",
      "Bash(gh auth status *)",
      "Bash(gh repo clone *)",
      "Bash(gh repo view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge * --auto *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run rerun *)",
      "Bash(gh workflow run review-gate.yml *)",
      "Bash(gh label list *)",
      "Bash(gh api repos/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * --delete *)",
      "Bash(git push * :*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --input *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh variable *)",
      "Bash(gh secret *)",
      "Bash(gh ruleset *)",
      "Bash(gh label create *)",
      "Bash(gh label delete *)",
      "Bash(gh release *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
